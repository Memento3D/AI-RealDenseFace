{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Memento3D hair library contract v1",
  "type": "object",
  "required": [
    "schema_version",
    "assets"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "path",
          "sha256",
          "input_units",
          "source_to_y_up",
          "inner_roof_y",
          "inner_radius",
          "source_base_y",
          "limits",
          "custom"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,48}$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "description": "Project-relative path; runtime rejects resolved path escapes"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-fA-F0-9]{64}$"
          },
          "input_units": {
            "type": "string"
          },
          "source_to_y_up": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "items": {
                "type": "number"
              }
            },
            "description": "Runtime also checks orthonormality and determinant +1"
          },
          "inner_roof_y": {
            "type": "number"
          },
          "inner_radius": {
            "type": "number",
            "exclusiveMinimum": 1,
            "exclusiveMaximum": 100
          },
          "source_base_y": {
            "type": "number"
          },
          "limits": {
            "type": "object",
            "required": [
              "scale_min",
              "scale_max",
              "cage_displacement_mm"
            ],
            "properties": {
              "scale_min": {
                "type": "number"
              },
              "scale_max": {
                "type": "number"
              },
              "cage_displacement_mm": {
                "type": "number"
              }
            }
          },
          "custom": {
            "type": "object",
            "properties": {
              "volume": {
                "type": "number",
                "minimum": -0.2,
                "maximum": 0.2
              },
              "fringe_lift_mm": {
                "type": "number",
                "minimum": -1,
                "maximum": 1
              },
              "nape_lift_mm": {
                "type": "number",
                "minimum": -1,
                "maximum": 1
              },
              "yaw_deg": {
                "type": "number",
                "minimum": -15,
                "maximum": 15
              }
            }
          }
        }
      }
    }
  }
}