+import hashlib,json,subprocess,sys,tempfile,unittest
+import os
+from pathlib import Path
+from scripts.prepare_subject_template import bind_template
+
+ROOT=Path(__file__).resolve().parents[1]
+
+class WindowsPortabilityTests(unittest.TestCase):
+    def test_unicode_review_and_json_with_legacy_windows_encoding(self):
+        with tempfile.TemporaryDirectory() as temporary:
+            script="from pathlib import Path; from scripts.run_face_on_glb import review_page; from chibi_face_transfer.config import write_json; p=Path("+repr(temporary)+"); review_page(p,Path('men.glb'),{s:Path(s+'.png') for s in ['front','left','right']},None); write_json(p/'unicode.json',{'name':'Ph\\u01b0\\u1edbc'})"
+            env=os.environ.copy();env['PYTHONPATH']=str(ROOT);env['PYTHONUTF8']='0'
+            result=subprocess.run([sys.executable,'-X','utf8=0','-c',script],cwd=temporary,env=env,capture_output=True)
+            self.assertEqual(result.returncode,0,result.stderr)
+            page=(Path(temporary)/'review.html').read_text(encoding='utf-8')
+            self.assertIn('Kết quả ghép khuôn mặt',page)
+            self.assertNotIn('<img src="transfer/previews/',page)
+            self.assertEqual(json.loads((Path(temporary)/'unicode.json').read_text(encoding='utf-8'))['name'],'Phước')
+
+    def test_cli_is_importable_from_foreign_directory(self):
+        with tempfile.TemporaryDirectory() as temporary:
+            result=subprocess.run([sys.executable,str(ROOT/'scripts/run_face_on_glb.py'),'--help'],cwd=temporary,capture_output=True,text=True)
+        self.assertEqual(result.returncode,0,result.stderr)
+        self.assertIn('--face-python',result.stdout)
+        self.assertIn('--split-python',result.stdout)
+
