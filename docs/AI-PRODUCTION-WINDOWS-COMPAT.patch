+import unittest
+from unittest.mock import Mock,patch
+import windows_runtime_budget as budget
+
+class WindowsRuntimeBudgetTests(unittest.TestCase):
+    def test_low_start_memory_does_not_spawn_worker(self):
+        with patch.object(budget,'available_ram',return_value=0),patch.object(budget.subprocess,'Popen') as spawn:
+            with self.assertRaises(MemoryError):
+                budget.run_guarded(['fixture'],cwd='.',env={},stdout=None,timeout=1,minimum=50,abort=10)
+            spawn.assert_not_called()
+
+    def test_memory_abort_stops_only_owned_worker_tree(self):
+        child=Mock(pid=4321);child.poll.return_value=None
+        with patch.object(budget,'available_ram',side_effect=[100,0]),patch.object(budget.subprocess,'Popen',return_value=child),patch.object(budget.subprocess,'run') as stop,patch.object(budget.sys,'platform','win32'):
+            with self.assertRaises(MemoryError):
+                budget.run_guarded(['fixture'],cwd='.',env={},stdout=None,timeout=1,minimum=50,abort=10)
+            stop.assert_called_once_with(['taskkill','/PID','4321','/T','/F'],capture_output=True)
+            child.wait.assert_called_once()
